NODE_ENV=development
HOST=0.0.0.0
PORT=3333
DELIVERY_MODE=dry-run
DATA_DIR=./data
AUTOMATIONS_FILE=./config/automations.example.json
PUBLIC_BASE_URL=http://localhost:3333

# Use long, random values. Never commit real secrets.
ADMIN_API_KEY=replace-with-at-least-24-random-characters
WEBCHAT_SITE_TOKEN=replace-with-at-least-24-random-characters
META_VERIFY_TOKEN=replace-with-at-least-24-random-characters
META_APP_SECRET=replace-with-at-least-24-random-characters

META_APP_ID=
META_API_VERSION=v26.0
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# Instagram · Capital do Engano
CAPITAL_INSTAGRAM_LABEL=Capital do Engano
CAPITAL_INSTAGRAM_ACCOUNT_ID=
CAPITAL_INSTAGRAM_ACCESS_TOKEN=

# Instagram · perfil do Gu
GU_INSTAGRAM_LABEL=@ogustavosouzapauli
GU_INSTAGRAM_ACCOUNT_ID=
GU_INSTAGRAM_ACCESS_TOKEN=

# Optional backward-compatible fallback for a single Instagram account.
INSTAGRAM_ACCESS_TOKEN=

# Optional Messenger / Facebook Page connection.
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# WhatsApp Cloud API
WHATSAPP_LABEL=Capital do Engano · WhatsApp
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
